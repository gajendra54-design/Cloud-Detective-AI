POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DEMO_CONTROL_TOKEN=replace-with-a-different-long-random-token

INVESTIGATOR_TOKEN=replace-with-a-separate-random-investigator-token
APPROVER_TOKEN=replace-with-a-separate-random-approver-token
GRAFANA_PASSWORD=replace-with-a-random-grafana-password
AI_PROVIDER=mock
OLLAMA_MODEL=qwen2.5:3b

# Disable shared role credentials after creating individual accounts.
LEGACY_TOKENS_ENABLED=true

# Slow CPU-only local inference may require up to 180 seconds per attempt.
AI_TIMEOUT_SECONDS=15
OLLAMA_URL=http://host.docker.internal:11434
